# 复制此文件为 .env，并填写所需的 API Key。不要提交 .env。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
MODEL_CONTEXT_WINDOW=1000000
MAX_OUTPUT_TOKENS=2048
DEEPSEEK_REQUEST_TIMEOUT=60
DEEPSEEK_MAX_RETRIES=1

# PostgreSQL + 用户会话
POSTGRES_URI=postgresql://langchain:langchain_dev@localhost:5432/langchain?sslmode=disable
CHAT_USER_ID=lk
CHAT_THREAD_ID=personal-chat
LANGGRAPH_URL=http://127.0.0.1:2024
PORT=8080
KNOWLEDGE_DIR=knowledge

# 当前项目在 WSL 中访问 Windows Ollama；纯 Linux 本机可改为 127.0.0.1。
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_VISION_MODEL=qwen3-vl:4b-instruct
OLLAMA_VISION_WARMUP_TIMEOUT=10
OLLAMA_VISION_TIMEOUT=30

# 联网搜索网页与视觉处理
PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers
WEB_BROWSER_MAX_CONCURRENCY=3
WEB_VISION_MAX_CONCURRENCY=2
# none=不保留，disk=保存JPEG文件，state=在LangGraph状态中保留Base64
WEB_SCREENSHOT_RETENTION=none
WEB_SCREENSHOT_DIR=artifacts/web_screenshots

# AnySearch 联网搜索 API Key
ANYSEARCH_API_KEY=

# Langfuse 可观测性（留空则禁用）
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development

# LangSmith 可观测性
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=我的agent
